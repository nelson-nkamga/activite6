<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Atelier6.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="16">

            <Label
                Text="Nom"
                FontSize="32" />
            
            <Entry x:Name="NomEntry" Placeholder="Entrez votre nom" />

            <Label
                Text="Date de naissance!"
                FontSize="16" />
            <DatePicker x:Name="DateNaissancePicker" />

            <Button
                x:Name="btnCalculer"
                Text="Calculer l'âge"
                Clicked="OnCalculerClicked"/>
            <Label
                x:Name="lblResultat"
                Text=""
                FontSize="20" 
                IsVisible="False" />
                
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
